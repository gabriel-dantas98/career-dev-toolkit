{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabriel-dantas98/career-dev-toolkit/evals/result.schema.json",
  "title": "Career Dev Toolkit evaluation result",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "startedAt",
    "finishedAt",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "static",
        "providers"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array"
    }
  }
}
